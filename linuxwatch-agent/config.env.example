# LinuxWatch Agent — Configuration
# Copy this file to config.env and fill in your values.
# Usage: python3 agent.py --config config.env

# ── Required ────────────────────────────────────────────────────────────────

# JWT token from your LinuxWatch account.
# Get it: log in to the frontend → DevTools → Application → localStorage → lw_token
JWT_TOKEN=your_jwt_token_here

# ── Backend URL ─────────────────────────────────────────────────────────────

# Same machine as backend:
BACKEND=http://localhost:5001

# Separate server (replace with your backend's IP or hostname):
# BACKEND=http://192.168.1.10:3001

# ── Log file paths ──────────────────────────────────────────────────────────
# Comma-separated list. Remove any paths that don't exist on your system.

LOG_PATHS=/var/log/auth.log,/var/log/syslog,/var/log/ufw.log,/var/log/kern.log,/var/log/nginx/access.log

# Production mode reads real UFW/netfilter firewall logs for port scans.
# Keep synthetic listeners disabled on deployed hosts.
PROBE_PORTS=3333,3444,3555,3666,3777,3888,3999,4111,4222,4333,4444
ENABLE_PROBE_LISTENER=false

# Test-only options. Production deployments should leave both disabled.
SSH_TRAP_PORT=2222
ENABLE_TEST_TRAP=false
ENABLE_AUTHORIZED_KEYS_WATCH=true
SSH_AUTHORIZED_KEYS_PATH=~/.ssh/authorized_keys

# macOS equivalents (uncomment if running on Mac):
# LOG_PATHS=/var/log/system.log,/usr/local/var/log/nginx/access.log